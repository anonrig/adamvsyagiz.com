---
export const prerender = false

import ActivityHeatmap from '@/components/ActivityHeatmap.astro'
import BadgeWall from '@/components/BadgeWall.astro'
import BeltBanner from '@/components/BeltBanner.astro'
import Countdown from '@/components/Countdown.astro'
import FighterCard from '@/components/FighterCard.astro'
import Hud from '@/components/Hud.astro'
import LogTable from '@/components/LogTable.astro'
import QuestBoard from '@/components/QuestBoard.astro'
import RaceChart from '@/components/RaceChart.astro'
import ScoreDuel from '@/components/ScoreDuel.astro'
import SectionHead from '@/components/SectionHead.astro'
import StrengthBoard from '@/components/StrengthBoard.astro'
import WeightCharts from '@/components/WeightCharts.astro'
import {
  ACTIVITY_BONUS,
  ACTIVITY_POINTS,
  MAXIMUM_SCORE,
  NORMAL_SCORE,
  PRIZE_USD,
  STRENGTH_POINTS,
  TOTAL_WEEKS,
  WEIGHT_POINTS,
  adam,
  yagiz,
} from '@/lib/challenge'
import { homepageJsonLd, latestCheckinDate, supportTweetUrl } from '@/lib/seo'
import { buildStandings, formatInches, formatLbs, formatPts } from '@/lib/scoring'
import { loadCheckins } from '@/lib/checkin-store'
import { checkins as seedCheckins } from '@/data/checkins'
import Layout from '@/layouts/Layout.astro'
import { env } from 'cloudflare:workers'

const rows = await loadCheckins(env.CHECKINS, seedCheckins)
const standings = buildStandings(new Date(), rows)
---

<Layout jsonLd={homepageJsonLd()} modifiedDate={latestCheckinDate(rows)}>
  <Hud standings={standings} />

  <main id="main">
    <section class="mx-auto w-full max-w-6xl px-[clamp(1.1rem,4vw,2rem)] pt-8 pb-8 text-center" id="top">
      <p class="m-0 text-[0.76rem] font-semibold tracking-[0.16em] text-gold uppercase">Live challenge HQ</p>
      <p class="mt-2 text-ink-dim tracking-wide">September 1, 2026 — April 11, 2027</p>

      <div class="my-7 grid items-center gap-3 max-[520px]:grid-cols-1 min-[521px]:grid-cols-[1fr_auto_1fr]">
        <div class="min-[521px]:text-right max-[520px]:text-center">
          <p class="m-0 text-[0.76rem] font-semibold tracking-[0.16em] text-gold uppercase">{adam.corner}</p>
          <p class="m-0 font-display text-[clamp(3.4rem,15vw,8rem)] leading-none text-adam">{adam.name}</p>
          <p class="mt-1 font-display text-[clamp(2rem,7vw,3.2rem)] leading-none text-adam">
            {formatPts(standings.adam.total)}
          </p>
          <p class="mt-1 text-ink-dim">{standings.adam.title}</p>
        </div>
        <div
          class="grid size-[clamp(3.4rem,10vw,5rem)] place-items-center justify-self-center rounded-full border border-gold bg-[#1a160e] font-display text-[clamp(1.3rem,4vw,1.8rem)] tracking-widest text-gold shadow-[0_0_0_8px_rgb(227_178_60_/_0.06)]"
          aria-hidden="true"
        >
          VS
        </div>
        <div class="min-[521px]:text-left max-[520px]:text-center">
          <p class="m-0 text-[0.76rem] font-semibold tracking-[0.16em] text-gold uppercase">{yagiz.corner}</p>
          <p class="m-0 font-display text-[clamp(3.4rem,15vw,8rem)] leading-none text-yagiz">{yagiz.name}</p>
          <p class="mt-1 font-display text-[clamp(2rem,7vw,3.2rem)] leading-none text-yagiz">
            {formatPts(standings.yagiz.total)}
          </p>
          <p class="mt-1 text-ink-dim">{standings.yagiz.title}</p>
        </div>
      </div>

      <h1 class="m-0 font-display text-[clamp(1.7rem,5.4vw,3.2rem)] leading-none tracking-wide text-gold-2">
        ${PRIZE_USD.toLocaleString('en-US')} Spring Break Fitness Challenge
      </h1>
      <p class="mx-auto mt-3 mb-6 max-w-lg text-ink-dim">
        Two good friends. One belt. Highest score takes the purse. The site keeps score so neither of you can hide.
      </p>
      <p class="mx-auto mb-6 max-w-lg text-ink-dim">
        To show support for Adam or Yagiz, leave a reply on
        <a class="text-gold no-underline hover:underline" href={supportTweetUrl} target="_blank" rel="noopener noreferrer">
          the announcement
        </a>.
      </p>
      <Countdown />
    </section>

    <section class="mx-auto w-full max-w-6xl px-[clamp(1.1rem,4vw,2rem)] pb-10" id="score">
      <BeltBanner standings={standings} />
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        <FighterCard person={standings.adam} standings={standings} />
        <FighterCard person={standings.yagiz} standings={standings} />
      </div>
      <div class="mt-4">
        <ScoreDuel standings={standings} />
      </div>
    </section>

    <section class="mx-auto w-full max-w-6xl px-[clamp(1.1rem,4vw,2rem)] pb-12" id="quests">
      <SectionHead num="01" kicker="This week" title="Quests" />
      <p class="mb-4 max-w-2xl text-ink-dim">
        Four boxes. Every week. Miss the walks and you donate a point to the void. The void does not split the $3,000.
      </p>
      <QuestBoard standings={standings} />
    </section>

    <section class="mx-auto w-full max-w-6xl px-[clamp(1.1rem,4vw,2rem)] pb-12" id="cut">
      <SectionHead num="02" kicker={`${WEIGHT_POINTS} points`} title="The cut" />
      <p class="mb-4 max-w-2xl text-ink-dim">
        Adam: {formatLbs(adam.startWeight)} → {formatLbs(adam.goalWeight)} ({formatLbs(adam.toLose)} lbs)
        {standings.adam.startWaist !== null ? `, ${formatInches(standings.adam.startWaist)} in waist` : ''}. Yagiz:{' '}
        {formatLbs(yagiz.startWeight)} → {formatLbs(yagiz.goalWeight)} ({formatLbs(yagiz.toLose)} lbs)
        {standings.yagiz.startWaist !== null ? `, ${formatInches(standings.yagiz.startWaist)} in waist` : ''}. Same
        scoreboard, personal mountains.
      </p>
      <div class="grid gap-3">
        <RaceChart standings={standings} />
        <WeightCharts standings={standings} />
      </div>
    </section>

    <section class="mx-auto w-full max-w-6xl px-[clamp(1.1rem,4vw,2rem)] pb-12" id="strength">
      <SectionHead num="03" kicker={`${STRENGTH_POINTS} points`} title="Strength" />
      <p class="mb-4 max-w-2xl text-ink-dim">
        Push-ups, inverted rows, overhead press (reps × load). You are scored against yourself. Opening tests are the
        baselines. Get stronger or get leftover points.
      </p>
      <StrengthBoard standings={standings} />
    </section>

    <section class="mx-auto w-full max-w-6xl px-[clamp(1.1rem,4vw,2rem)] pb-12" id="steps">
      <SectionHead num="04" kicker={`${ACTIVITY_POINTS}+${ACTIVITY_BONUS} points`} title="Step seasons" />
      <p class="mb-4 max-w-2xl text-ink-dim">
        10,000 steps on four days, every challenge week. 25 is the floor. 32 is bragging rights.
      </p>
      <ActivityHeatmap standings={standings} />
    </section>

    <section class="mx-auto w-full max-w-6xl px-[clamp(1.1rem,4vw,2rem)] pb-12" id="log">
      <SectionHead num="05" kicker="Official book" title="Weekly log" />
      <LogTable standings={standings} />
    </section>

    <section class="mx-auto w-full max-w-6xl px-[clamp(1.1rem,4vw,2rem)] pb-12" id="belts">
      <SectionHead num="06" kicker="Unlocks" title="Belts & badges" />
      <p class="mb-4 max-w-2xl text-ink-dim">
        Earn them in public. Locked badges are supposed to itch.
      </p>
      <BadgeWall standings={standings} />
    </section>

    <section class="mx-auto w-full max-w-6xl px-[clamp(1.1rem,4vw,2rem)] pb-12" id="rules">
      <SectionHead num="07" kicker="Winner takes all" title="How you win" />
      <table class="mb-5 w-full border-collapse border border-line bg-card">
        <caption class="sr-only">Score breakdown</caption>
        <thead>
          <tr>
            <th class="px-4 py-3 text-left text-[0.75rem] font-semibold tracking-widest text-mute uppercase">Category</th>
            <th class="px-4 py-3 text-right text-[0.75rem] font-semibold tracking-widest text-mute uppercase">Normal</th>
            <th class="px-4 py-3 text-right text-[0.75rem] font-semibold tracking-widest text-mute uppercase">Max</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="border-t border-line px-4 py-3">Weight loss · % of your goal</td>
            <td class="border-t border-line px-4 py-3 text-right">{WEIGHT_POINTS}</td>
            <td class="border-t border-line px-4 py-3 text-right">{WEIGHT_POINTS}</td>
          </tr>
          <tr>
            <td class="border-t border-line px-4 py-3">Strength · % vs your baseline</td>
            <td class="border-t border-line px-4 py-3 text-right">{STRENGTH_POINTS}</td>
            <td class="border-t border-line px-4 py-3 text-right">{STRENGTH_POINTS}</td>
          </tr>
          <tr>
            <td class="border-t border-line px-4 py-3">Activity · 4 days at 10k / week</td>
            <td class="border-t border-line px-4 py-3 text-right">{ACTIVITY_POINTS}</td>
            <td class="border-t border-line px-4 py-3 text-right">{TOTAL_WEEKS}</td>
          </tr>
        </tbody>
        <tfoot>
          <tr>
            <th class="border-t border-line px-4 py-3 text-left font-display text-[1.4rem] font-normal text-gold-2">Total</th>
            <th class="border-t border-line px-4 py-3 text-right font-display text-[1.4rem] font-normal text-gold-2">
              {NORMAL_SCORE}
            </th>
            <th class="border-t border-line px-4 py-3 text-right font-display text-[1.4rem] font-normal text-gold-2">
              {MAXIMUM_SCORE}
            </th>
          </tr>
        </tfoot>
      </table>
      <div class="grid gap-3 md:grid-cols-2">
        <article class="border border-line bg-card p-4">
          <p class="m-0 text-[0.76rem] font-semibold tracking-[0.16em] text-gold uppercase">Final day</p>
          <h2 class="mt-1 mb-2 font-display text-[clamp(2rem,7vw,3rem)] leading-none">April 11, 2027</h2>
          <p class="m-0 text-ink-dim">Last weigh-in. Final strength test. Scores lock.</p>
        </article>
        <article class="border border-line bg-card p-4">
          <p class="m-0 text-[0.76rem] font-semibold tracking-[0.16em] text-gold uppercase">Spring break</p>
          <h2 class="mt-1 mb-2 font-display text-[clamp(2rem,7vw,3rem)] leading-none">April 12, 2027</h2>
          <p class="m-0 text-ink-dim">The day after. One of you is $3,000 lighter. The other paid for it.</p>
        </article>
      </div>
    </section>
  </main>

  <footer
    class="border-t border-line px-[clamp(1.1rem,4vw,2rem)] py-6 text-center text-[0.88rem] text-mute"
    style="padding-bottom: calc(1.6rem + env(safe-area-inset-bottom))"
  >
    <p class="m-0">Adam vs Yagiz · Live standings · Winner takes ${PRIZE_USD.toLocaleString('en-US')}</p>
    <p class="mt-1">
      Show support:
      <a class="text-gold no-underline hover:underline" href={supportTweetUrl} target="_blank" rel="noopener noreferrer">
        reply on X
      </a>
      ·
      <a href="/standings.json">standings.json</a>
      ·
      <a href="/log">log a week</a>
    </p>
  </footer>
</Layout>
